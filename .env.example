# Safe default: no exchange submissions.
DRY_RUN=true
KILL_SWITCH=false

DATABASE_URL=postgresql+asyncpg://syncopy:syncopy@localhost:5432/syncopy
AUTO_CREATE_SCHEMA=true
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# address:weight entries. Estimated capital may be supplied separately below.
TARGETS=
TARGET_CAPITALS=
# Optional seed subscriptions; target position token IDs are added dynamically.
MARKET_TOKEN_IDS=

POLL_INTERVAL_S=4
RECONCILE_INTERVAL_S=20
WS_BATCH_SIZE=50
HTTP_TIMEOUT_S=10

OWN_CAPITAL_USD=1000
MAX_MARKET_EXPOSURE_PCT=5
MAX_TOTAL_EXPOSURE_PCT=50
MAX_ORDER_SIZE_USD=100
MAX_DEPTH_FRACTION=0.10
SLIPPAGE_TOLERANCE_PCT=2
PRICE_BUFFER_TICKS=1
MAX_TARGET_PRICE_MOVE_PCT=3
ORDER_TTL_S=15
PNL_SNAPSHOT_INTERVAL_S=10
DAILY_LOSS_HALT_USD=50
MIN_DAYS_TO_RESOLUTION=1
BLOCKED_TOKEN_IDS=

# Required only when DRY_RUN=false. The wallet is the funded Deposit Wallet.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_DEPOSIT_WALLET=

HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
LOG_LEVEL=INFO
